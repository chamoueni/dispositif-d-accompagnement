{
  "name": "dispositif-d-accompagnement",
  "private": true,
  "version": "0.0.0",
  "description": "Au Fil des Âges : mise en relation des personnes âgées de Mayotte avec du personnel de santé et des particuliers (Vue 3 + Express + PostgreSQL, hébergé sur alwaysdata).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "server": "node backend/app.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build --config frontend/vite.config.js && node frontend/scripts/generate-seo-pages.js",
    "start": "node backend/app.js",
    "lint": "eslint .",
    "preview": "vite preview --config frontend/vite.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "sass": "^1.102.0",
    "vite": "^8.2.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.2.0"
  }
}
