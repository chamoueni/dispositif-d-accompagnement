# Modèle du fichier .env : copie-le en « .env » (à la racine du projet) et remplis
# les valeurs. Le vrai .env contient des secrets : il est dans .gitignore et ne
# doit JAMAIS être envoyé sur GitHub. Sur alwaysdata, ces mêmes variables se
# saisissent dans Web › Sites › (le site) › Environnement (voir DEPLOIEMENT.md).

# --- Base de données PostgreSQL (alwaysdata) ---------------------------------
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HÔTE:5432/NOM_DE_LA_BASE
# Exemple : postgresql://moustakim_app:xxxx@postgresql-moustakim.alwaysdata.net:5432/moustakim_aufildesages
# (si le mot de passe contient des caractères spéciaux comme @ : / #, les encoder, ex. @ → %40)
DATABASE_URL=
# true seulement si la base exige une connexion chiffrée (pas nécessaire sur alwaysdata).
DATABASE_SSL=false

# --- Connexion des utilisateurs (JWT) ----------------------------------------
# Clé secrète qui signe les jetons de connexion : au moins 32 caractères
# aléatoires, DIFFÉRENTE en local et en production. Pour en générer une :
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Durée de connexion : avec « Se souvenir de moi » (jours) / sans (heures).
AUTH_REMEMBER_DAYS=30
AUTH_SESSION_HOURS=12

# --- Serveur -----------------------------------------------------------------
# Port d'écoute. En local : 3001 (le serveur Vite y redirige /api). Sur
# alwaysdata, PORT et IP sont fournis automatiquement : ne pas les définir.
PORT=3001
# « production » sur alwaysdata (cookies HTTPS uniquement), vide en local.
NODE_ENV=

# Adresse publique du site, sans « / » final. Sert aux liens envoyés par email
# et au contrôle d'origine des requêtes. Local : http://localhost:5173
# Production : https://moustakim.alwaysdata.net/aufildesages (le sous-dossier est pris en compte)
SITE_URL=http://localhost:5173
# Même adresse, lue par Vite au build (URL canoniques, sitemap).
VITE_SITE_URL=
# Autres adresses autorisées à appeler l'API, séparées par des virgules (rarement utile).
CORS_ORIGINS=

# --- Emails (serveur SMTP d'alwaysdata) ----------------------------------------
# Créer une adresse dans alwaysdata › Emails › Adresses, puis renseigner :
# hôte smtp-moustakim.alwaysdata.net, port 587, identifiant = l'adresse complète.
# En local, sans ces valeurs, les emails sont affichés dans le terminal au lieu d'être envoyés.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché (par défaut SMTP_USER), ex. Au Fil des Ages <contact@...>
EMAIL_EXPEDITEUR=
# Adresse qui reçoit une alerte à chaque message envoyé par le bouton SOS (vide = pas d'alerte).
EMAIL_ADMIN=
