# Copie ce fichier en ".env" et remplace par les valeurs de ton projet Supabase
# (Project Settings > API sur supabase.com). Le préfixe VITE_ est obligatoire :
# Vite n'expose au code client que les variables d'environnement qui l'ont.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Variables réservées au serveur Express : ne jamais les préfixer par VITE_.
# La clé service_role ne doit jamais être envoyée au navigateur ni commitée.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Clé API Anthropic (console.anthropic.com) pour l'assistant IA du bouton SOS
# (endpoint /api/chat-ia dans server/index.js). Sans elle, le chat retombe sur
# des réponses FAQ statiques codées dans SosButton.vue.
ANTHROPIC_API_KEY=
