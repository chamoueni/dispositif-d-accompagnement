# Copie ce fichier en ".env" et renseigne les URL/identifiants de ton projet.

# URL du service Render qui fait tourner server/index.js (chat IA + API adhérents),
# séparé du site statique qui sert le frontend. Laisser vide en local (le proxy
# Vite s'en charge, voir vite.config.js) ; en prod, ex. https://mon-api.onrender.com
# (sans "/" final).
VITE_API_URL=

# Domaine public du site : renseigner la même origine dans les deux variables.
# VITE_SITE_URL est utilisé pour les URL canoniques et le sitemap généré au build.
VITE_SITE_URL=
SITE_URL=

# Variables réservées au serveur Express : ne jamais les préfixer par VITE_.
# La clé service_role ne doit jamais être envoyée au navigateur ni commitée.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sessions BFF : générer AUTH_SESSION_SECRET avec
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=
AUTH_REMEMBER_DAYS=30
AUTH_SESSION_HOURS=12
# Lax convient si le site et l'API sont sur le même site (sous-domaines inclus).
# Pour deux domaines distincts, utiliser None et HTTPS obligatoire.
COOKIE_SAME_SITE=lax
# Origines frontend additionnelles, séparées par des virgules.
CORS_ORIGINS=

# Base NoSQL MongoDB pour les adhérents (server/adherentsStore.js), ex. une
# base gratuite MongoDB Atlas : mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net
# Laisser vide en local pour utiliser le fichier server/data/adherents.json.
# À renseigner sur Render : son disque est effacé à chaque redéploiement.
MONGODB_URI=
MONGODB_DB=dispositif

# Clé API Anthropic (console.anthropic.com) pour l'assistant IA du bouton SOS
# (endpoint /api/chat-ia dans server/index.js). Sans elle, le chat retombe sur
# des réponses FAQ statiques codées dans SosButton.vue.
ANTHROPIC_API_KEY=
